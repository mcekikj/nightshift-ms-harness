# ---- Model provider -------------------------------------------------------
# "foundry"      -> Microsoft Foundry project (recommended, gives you Foundry tracing)
# "azure-openai" -> Azure OpenAI resource (Responses API, Entra ID auth)
# "openai"       -> OpenAI directly (API key)
NIGHTSHIFT_PROVIDER=foundry

# Foundry project (az login first)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-6-luna

# Azure OpenAI resource (az login first; needs the "Cognitive Services OpenAI User" role)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI (only for NIGHTSHIFT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_ID=

# ---- Telemetry ------------------------------------------------------------
# none | console | otlp | azure-monitor | foundry
NIGHTSHIFT_TELEMETRY=none
# otlp: any OTLP/HTTP collector, for example the Aspire dashboard (mcr.microsoft.com/dotnet/aspire-dashboard)
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# azure-monitor: export straight to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Record prompts, tool arguments and results in traces (dev only!)
ENABLE_SENSITIVE_DATA=false
